    "start": 652.6,
    "end": 654.1,
    "text": "इने कन लाई के अगर ता"
   },
   {
    "start": 654.1,
    "end": 656.1,
    "text": "कन लाई"
   },
   {
    "start": 656.1,
    "end": 657.6,
    "text": "मारवाडी मारवाडी"
   },
   {
    "start": 657.6,
    "end": 659.6,
    "text": "अगर दे विशाल जागन"
   },
   {
    "start": 659.6,
    "end": 661.6,
    "text": "जागन भी लाग तो रवे"
   },
   {
    "start": 661.6,
    "end": 663.2,
    "text": "बख्त लोग जी का"
   },
   {
    "start": 663.2,
    "end": 665.2,
    "text": "अब तर आट"
   },
   {
    "start": 665.2,
    "end": 667.2,
    "text": "अगर तो खूव आचामिदि के जी को"
   },
   {
    "start": 667.2,
    "end": 669.2,
    "text": "बट है कूव"
   },
   {
    "start": 672.2,
    "end": 674.2,
    "text": "आट बी कूव गना साड़ आट"
   },
   {
    "start": 674.2,
    "end": 678.2,
    "text": "तो एर्ये माड गय आट"
   },
   {
    "start": 678.2,
    "end": 680.2,
    "text": "आट डांगरान पानी पावन वाच ते गयान"
   },
   {
    "start": 680.2,
    "end": 682.2,
    "text": "गवाली आया कर आगाम शू"
   },
   {
    "start": 682.2,
    "end": 684.2,
    "text": "राम नगर सुझने"
   },
   {
    "start": 684.2,
    "end": 686.2,
    "text": "आस पास"
   },
   {
    "start": 686.2,
    "end": 690.8,
    "text": "जाम अगर लाग जी का"
   },
   {
    "start": 691.8,
    "end": 692.8,
    "text": "अख्मा बीजजी"
   },
   {
    "start": 692.8,
    "end": 694.8,
    "text": "खनंगा"
   },
   {
    "start": 694.8,
    "end": 696.8,
    "text": "वाजी"
   },
   {
    "start": 696.8,
    "end": 703.0,
    "text": "वाजी"
   },
   {
    "start": 703.0,
    "end": 760.3,
    "text": "जे अ पीर जी"
   },
   {
    "start": 760.3,
    "end": 762.3,
    "text": "वाच साड़"
   },
   {
    "start": 762.3,
    "end": 773.3,
    "text": "जोर्दार"
   },
   {
    "start": 773.3,
    "end": 775.3,
    "text": "अमें टीख है अख्मा राम जी"
   },
   {
    "start": 775.3,
    "end": 777.3,
    "text": "अग खना आगाम रो"
   },
   {
    "start": 777.3,
    "end": 779.3,
    "text": "पीर जीडी"
   },
   {
    "start": 779.3,
    "end": 781.3,
    "text": "अख्मा रो बीडियो बनाली अपा"
   },
   {
    "start": 781.3,
    "end": 783.3,
    "text": "और यो आगलो बीडियो"
   },
   {
    "start": 783.3,
    "end": 785.3,
    "text": "जिक अपा अपा काई आए"
   },
   {
    "start": 786.3,
    "end": 788.3,
    "text": "ओस के मैं नानेरा लो गर में जा बे"
   },
   {
    "start": 789.3,
    "end": 791.3,
    "text": "और लारलसाल में"
   },
   {
    "start": 791.3,
    "end": 793.3,
    "text": "दष्टाल पला एव लक भग"
   },
   {
    "start": 793.3,
    "end": 795.3,
    "text": "वर्हनाज..."
   },
   {
    "start": 795.3,
    "end": 797.3,
    "text": "दष्टाल पाश है यो आम पन खेये"
   },
   {
    "start": 797.3,
    "end": 799.3,
    "text": "मैं नानेर रो गर होनी"
   },
   {
    "start": 799.3,
    "end": 801.3,
    "text": "पटश यए अद आआ नहीं"
   },
   {
    "start": 801.3,
    "end": 803.3,
    "text": "अपन मैं माल याली भाद दीवार"
   },
   {
    "start": 803.3,
    "end": 806.3,
    "text": "पडी"
   },
   {
    "start": 806.3,
    "end": 808.3,
    "text": "और"
   },
   {
    "start": 808.3,
    "end": 811.6,
    "text": "निचा जग की साल में लिए ना है निदा है ना."
   },
   {
    "start": 811.6,
    "end": 813.3,
    "text": "निचा जग की साल बनुदे नी माकान."
   },
   {
    "start": 813.3,
    "end": 816.3,
    "text": "निस्वाल मैं इस दिवार राख्विडी साइड में."
   },
   {
    "start": 816.3,
    "end": 819.7,
    "text": "यर बा, आलो राख्विडी जिकिन मोरी बोली आगरा."
   },
   {
    "start": 819.7,
    "end": 823.0,
    "text": "वी न में भार, लक्डी भी पडी, किता साला दो बागली कोनी?"
   },
   {
    "start": 823.3,
    "end": 826.3,
    "text": "निता आग़ ना योंके तुभ स्फिज्चुत्षाश लो या."
   },
   {
    "start": 826.9,
    "end": 830.3,
    "text": "तुबा वो बदार उएक तभा दस साल प्यला आईो बंई,"
   },
   {
    "start": 830.9,
    "end": 833.9,
    "text": "यभनाल कै भीटि आ मझाया."
   },
   {
    "start": 833.9,
    "end": 835.4,
    "text": "तीक, मत आगल बीटिए!"
   },
   {
    "start": 835.4,
    "end": 865.4,
    "text": "फिर अव भीट्वा थे समाप्ति करो और अगला मारा यूटुप चैनूश जुड्योडा या और भीजे नेया मेमान आमन आला है देख तरेजो और स्ब्स्क्रिव करजो जिकानी करेजो और में भजन वानी संगीत कला रसात सात काई आपन आपने एत्या सीक बातना आजे कि क"
   },
   {
    "start": 865.4,
    "end": 875.8,
    "text": "तो रही हो ला दन्येवाद जैहिन जैबारत आरसूटार जैसलिमर के सात मने रही है आरसूटार जैसलिमर चैनूट पर आरियोब"
   },
   {
    "start": 1016.7,
    "end": 1017.4,
    "text": "बजन में लार लिजी आंद साल पेल आएगुजन बता है लिए ख़्ड़ी अंद पीिंड में आ लखडी जे के कैमपडी आ दे को सा लखडी अजे कैमपडी एत है कडी नी आजोटानी, किता साल पुरणी करकनाज़ी, करकनाज़ी उर्योट आनबा देकि मैं बताँ जे की �"
   },
   {
    "start": 1046.7,
    "end": 1062.3,
    "text": "अब उनी सुच्या सी मुत्यो, अदे को दे उखुंटो रोपिडो ने दे, आखारी गरी गड़ो दे को, अदे बसोलो लागगड़ो, अदे बसोलो लागड़ो, अदे कोई प्रकारी नहीं ख्रोंची नहीं आए,"
   },
   {
    "start": 1063.3,
    "end": 1064.3,
    "text": "कमाल है नहीं?"
   },
   {
    "start": 1064.3,
    "end": 1065.3,
    "text": "कमाल है"
   },
   {
    "start": 1065.3,
    "end": 1066.3,
    "text": "अदे कोटे"
   },
   {
    "start": 1066.3,
    "end": 1071.3,
    "text": "हमें तक एक अबर सांट वन स्छुए दिवार आंखड़ी है,"
   },
   {
    "start": 1071.3,
    "end": 1078.3,
    "text": "जक दिर दिरे गिरन लागगी, और बभी न दे को दे कैई गर पडा है जे,"
   },
   {
    "start": 1080.3,
    "end": 1081.3,
    "text": "तुट्या पुट्या,"
   },
   {
    "start": 1083.3,
    "end": 1085.3,
    "text": "जाद्दास त्रूब में सब दे,"
   },
   {
    "start": 1085.3,
    "end": 1087.3,
    "text": "और मैं नानाजी रोग गर हो,"
   },
   {
    "start": 1087.3,
    "end": 1090.7,
    "text": "दन्ये बाग मराजे जो को आज मरे ने,"
   },
   {
    "start": 1092.7,
    "end": 1094.7,
    "text": "नानाजी ले गरे आई हूं,"
   },
   {
    "start": 1094.7,
    "end": 1097.7,
    "text": "पुट्यान एदे को जिक आला रक्वडा है,"
   },
   {
    "start": 1101.0,
    "end": 1103.0,
    "text": "और गर्गनाजी आला तो आजी पड़े हो,"
   },
   {
    "start": 1105.0,
    "end": 1107.0,
    "text": "इन में कोई स्मान राकन रखन वाज नहीं,"
   },
   {
    "start": 1107.0,
    "end": 1108.0,
    "text": "मोर्या पड़ी है,"
   },
   {
    "start": 1114.4,
    "end": 1116.4,
    "text": "बे पुड़ाने कोछ दिया भी पड़े है,"
   },
   {
    "start": 1116.4,
    "end": 1119.5,
    "text": "क्यों देवासी?"
   },
   {
    "start": 1131.9,
    "end": 1133.9,
    "text": "ईह और दार माथी कनधाई गवडी,"
   },
   {
    "start": 1133.9,
    "end": 1136.9,
    "text": "और गर्गनाजी अर मखाम्ते मरे दादे है,"
   },
   {
    "start": 1138.9,
    "end": 1140.9,
    "text": "अपमराम औद़ कुप कुत आगी देवाए,"
   },
   {
    "start": 1140.9,
    "end": 1142.9,
    "text": "यह शालते नि मरे दादे की सिने नहीं बहागा,"
   },
   {
    "start": 1142.9,
    "end": 1143.9,
    "text": "आदर दादे घर्धजी दी,"
   },
   {
    "start": 1143.9,
    "end": 1145.9,
    "text": "हम्माराम की खमाराम,"
   },
   {
    "start": 1145.9,
    "end": 1150.9,
    "text": "उसली खुमराम सुटारिष्नोदी है, आंगे दादददी जी, यहनी मेरे पदनन वा"
   },
   {
    "start": 1153.6,
    "end": 1156.0,
    "text": "वा मैं काम देको पाव जी हूँ"
   },
   {
    "start": 1156.0,
    "end": 1157.4,
    "text": "अला उला"
   },
   {
    "start": 1157.4,
    "end": 1160.2,
    "text": "आई दाददे गी तिपारी है दे, नला"
   },
   {
    "start": 1160.2,
    "end": 1161.1,
    "text": "शुनाए के"
   },
   {
    "start": 1161.1,
    "end": 1161.7,
    "text": "देट्या"
   },
   {
    "start": 1161.7,
    "end": 1163.1,
    "text": "अखे याथ तिपारी हूँ"
   },
   {
    "start": 1163.1,
    "end": 1164.0,
    "text": "तूरिआ थादे बासी"
   },
   {
    "start": 1164.0,
    "end": 1180.2,
    "text": "बदिये दिशे नी अथूल दो."
   },
   {
    "start": 1180.2,
    "end": 1182.2,
    "text": "अ, दिक लेटि बर दी या."
   },
   {
    "start": 1183.5,
    "end": 1185.2,
    "text": "साथ बथको अथो होगे."
   },
   {
    "start": 1185.2,
    "end": 1193.1,
    "text": "बदियो लेज दिम्ये."
   },
   {
    "start": 1193.1,
    "end": 1196.1,
    "text": "बदियो लेज जगा नोण शाथ पुछ यो आप्दे ये देरी."
   },
   {
    "start": 1196.1,
    "end": 1198.1,
    "text": "मार नाना लागरो लगरी."
   },
   {
    "start": 1198.1,
    "end": 1211.5,
    "text": "भिवाजे."
   },
   {
    "start": 1211.5,
    "end": 1212.5,
    "text": "बदियो जाजे."
   },
   {
    "start": 1212.5,
    "end": 1213.5,
    "text": "लोलोजाज."
   },
   {
    "start": 1213.5,
    "end": 1215.5,
    "text": "यम द़न लए हम ते पहली भार देखें"
   },
   {
    "start": 1216.1,
    "end": 1218.6,
    "text": "बढ़्द विच्छ अरो अदि़़ अगयो देखें"
   },
   {
    "start": 1221.2,
    "end": 1223.2,
    "text": "ऐईईईँ खरा जल जल आईईईईँ"
   },
   {
    "start": 1224.0,
    "end": 1231.3,
    "text": "आआँ बाल व्बि याल ता और देख लेख़ि बिट़"
   },
   {
    "start": 1233.1,
    "end": 1235.0,
    "text": "पड़िय नहें आज्ँऊ"
   },
   {
    "start": 1236.6,
    "end": 1238.6,
    "text": "पर पड़िय अशाम नहीं"
   },
   {
    "start": 1238.6,
    "end": 1244.1,
    "text": "सकूल बट्सी हूंते नहीं"
   },
   {
    "start": 1244.1,
    "end": 1248.3,
    "text": "उबा भ्या"
   },
   {
    "start": 1248.3,
    "end": 1250.3,
    "text": "अट्ते शी बतान तभी खेल्डों क्रिया"
   },
   {
    "start": 1250.3,
    "end": 1252.3,
    "text": "पक्कि को नहीं"
   },
   {
    "start": 1252.3,
    "end": 1253.3,
    "text": "पक्कि"
   },
   {
    "start": 1253.3,
    "end": 1257.1,
    "text": "तब येट तो लेगा ला"
   },
   {
    "start": 1257.1,
    "end": 1258.1,
    "text": "येट गानी"
   },
   {
    "start": 1258.1,
    "end": 1259.1,
    "text": "बट्तो आतो"
   },
   {
    "start": 1259.1,
    "end": 1273.6,
    "text": "बट्तर ये"
   },
   {
    "start": 1273.6,
    "end": 1277.3,
    "text": "अनल तिबार"
   },
   {
    "start": 1277.3,
    "end": 1279.3,
    "text": "मेरा तब दुख है"
   },
   {
    "start": 1279.3,
    "end": 1282.2,
    "text": "तब आतो"
   },
   {
    "start": 1282.2,
    "end": 1284.2,
    "text": "अखो कली पी मुता वार"
   },
   {
    "start": 1285.2,
    "end": 1286.2,
    "text": "बढ़वासे"
   },
   {
    "start": 1286.2,
    "end": 1287.2,
    "text": "बढ़़ दिबार"
   },
   {
    "start": 1287.2,
    "end": 1302.4,
    "text": "बढ़़ लग कमरो"
   },
   {
    "start": 1302.4,
    "end": 1310.2,
    "text": "पूरी आवा दिबासे थोट"
   },
   {
    "start": 1310.2,
    "end": 1311.2,
    "text": "खोए डवान है"
   },
   {
    "start": 1311.2,
    "end": 1314.2,
    "text": "अप पक्को नहीं उपर लग तिबार गे तब देडी"
   },
   {
    "start": 1314.2,
    "end": 1316.2,
    "text": "अच्च अच्च"
   },
   {
    "start": 1316.2,
    "end": 1317.2,
    "text": "टेली डगे"
   },
   {
    "start": 1317.2,
    "end": 1318.2,
    "text": "अप पुड़ा ना"
   },
   {
    "start": 1318.2,
    "end": 1320.2,
    "text": "अप टब प्रटेली"
   },
   {
    "start": 1321.2,
    "end": 1323.2,
    "text": "याम रणन ना जीग"
   },
   {
    "start": 1323.2,
    "end": 1325.2,
    "text": "इदिबार याली तजाद़च बदेली"
   },
   {
    "start": 1325.2,
    "end": 1327.2,
    "text": "या ऐप दिबार खी नी और खीन नी"
   },
   {
    "start": 1327.2,
    "end": 1332.0,
    "text": "और वाब वरना जी"
   },
   {
    "start": 1332.0,
    "end": 1334.0,
    "text": "तप नी आगन"
   },
   {
    "start": 1336.0,
    "end": 1339.5,
    "text": "और लिठ़ बडी देगी"
   },
   {
    "start": 1339.5,
    "end": 1341.5,
    "text": "या ऐँ बब बडी आदी"
   },
   {
    "start": 1341.5,
    "end": 1343.5,
    "text": "या बबाक लग देडी"
   },
   {
    "start": 1343.5,
    "end": 1345.5,
    "text": "ने झादद़ अप पूरी"
   },
   {
    "start": 1345.5,
    "end": 1348.2,
    "text": "मilles- injuries"
   },
   {
    "start": 1356.2,
    "end": 1358.2,
    "text": "अखि द़द यो Off situations"
   },
   {
    "start": 1375.9,
    "end": 1377.5,
    "text": "खेई लेग यार की जी जी"
   },
   {
    "start": 1381.4,
    "end": 1383.4,
    "text": "अगम के उड़ा है"
   },
   {
    "start": 1383.4,
    "end": 1385.4,
    "text": "अपनो कर वाद, बो कै लिँ कुड़ है बतावा"
   },
   {
    "start": 1385.4,
    "end": 1387.4,
    "text": "अगम कै उड़ा दिर देख है नागाक सब अगम"
   },
   {
    "start": 1387.4,
    "end": 1390.4,
    "text": "बी के लिए देख और बी रendasा जे सविटले जे से जए जो के"
   },
   {
    "start": 1390.4,
    "end": 1392.4,
    "text": "अगम कै लिए धिया, नहीं दे खेडि से"
   },
   {
    "start": 1392.4,
    "end": 1399.1,
    "text": "अफ्री अज़़ था देवासी क्यड़ौद"
   },
   {
    "start": 1399.1,
    "end": 1401.1,
    "text": "प्री अज़़ अच़़ तेवासी"
   },
   {
    "start": 1401.1,
    "end": 1403.1,
    "text": "अच़़ तेवासी"
   },
   {
    "start": 1403.1,
    "end": 1405.1,
    "text": "अटिषूँ सुटी शेनी"
   },
   {
    "start": 1405.1,
    "end": 1407.1,
    "text": "ऐदिले आज़ौद"
   },
   {
    "start": 1407.1,
    "end": 1409.1,
    "text": "अच़़ राँँगय"
   },
   {
    "start": 1409.1,
    "end": 1411.1,
    "text": "इदिले ज़़नी ज़़नी"
   },
   {
    "start": 1411.1,
    "end": 1413.1,
    "text": "नहीं जाएशाँच़ नहीं"
   },
   {
    "start": 1413.1,
    "end": 1416.5,
    "text": "यह दो ती ने नी आ है दीन छार हैं"
   },
   {
    "start": 1416.5,
    "end": 1426.2,
    "text": "नी एक ठेज"
   },
   {
    "start": 1426.2,
    "end": 1428.9,
    "text": "नी एक देबाज की बाज पट्र थी पीरवावावाल पुध साव"
   },
   {
    "start": 1430.1,
    "end": 1433.1,
    "text": "बह्शे ला रवें जे जागे ने चला एगे"
   },
   {
    "start": 1433.9,
    "end": 1435.5,
    "text": "बंच्द वैं उके भें"
   },
   {
    "start": 1435.5,
    "end": 1436.8,
    "text": "तो तल यागे"
   },
   {
    "start": 1436.8,
    "end": 1438.3,
    "text": "थेर"
   },
   {
    "start": 1438.3,
    "end": 1439.7,
    "text": "थेर जागे ने लाज"
   },
   {
    "start": 1439.7,
    "end": 1450.7,
    "text": "या ब मुँटरा लपुचा भजा, कमार बम साले कें गोन, पन था पडूग ने, पिरवाबार पर पेर ये साभ शकलाई जबर है ने?"
   },
   {
    "start": 1450.7,
    "end": 1464.2,
    "text": "पिरवाबार तो बादन बादन भजागन लगागागाड ने, गन अ बे गन गन कराते."
   },
   {
    "start": 1464.2,
    "end": 1465.2,
    "text": "बज्या थे"
   },
   {
    "start": 1465.2,
    "end": 1468.2,
    "text": "दे तो मंट्या लाद थो बंद चला वारे नहीं"
   },
   {
    "start": 1468.2,
    "end": 1470.2,
    "text": "बिंने हे कोन जाले हो।"
   },
   {
    "start": 1470.2,
    "end": 1472.2,
    "text": "बीरोबगानी"
   },
   {
    "start": 1472.2,
    "end": 1476.7,
    "text": "बा इन्या मुगरे हो नहीं"
   },
   {
    "start": 1476.7,
    "end": 1478.7,
    "text": "तो इन्या मुगरे वो भामार वाजना भो स्थाली कोने"
   },
   {
    "start": 1478.7,
    "end": 1480.7,
    "text": "बादु आन पुइं बागाम वादु"
   },
   {
    "start": 1480.7,
    "end": 1485.0,
    "text": "तो देव सथा है तो"
   },
   {
    "start": 1485.0,
    "end": 1487.0,
    "text": "भी ताल्गा मादार"
   },
   {
    "start": 1487.0,
    "end": 1493.5,
    "text": "जग्या सुनी वास्त"
   },
   {
    "start": 1493.5,
    "end": 1501.1,
    "text": "रो ही तक्डी कन लगी"
   },
   {
    "start": 1501.1,
    "end": 1503.5,
    "text": "चारुंसा प्रू निया मुंदो पड़ थो थदूंड़ूं नहीं"
   },
   {
    "start": 1503.5,
    "end": 1506.3,
    "text": "चारुंसा प्रू निया मुदो पड़थो दशूँब चारुंसा ते दान्ने नी"
   },
   {
    "start": 1506.3,
    "end": 1509.4,
    "text": "बोलो योधन तो"
   },
   {
    "start": 1555.5,
    "end": 1559.5,
    "text": "अराम सब के लिए बीट्या बनाया है"
   },
   {
    "start": 1559.5,
    "end": 1563.5,
    "text": "मुझे अमीद है कि जरुर आपको पसन्दाएगा"
   },
   {
    "start": 1563.5,
    "end": 1566.5,
    "text": "जे मेरे बढे भाई सावे बेसे"
   },
   {
    "start": 1566.5,
    "end": 1568.5,
    "text": "बढी बुवा के लगके है"
   },
   {
    "start": 1568.5,
    "end": 1572.5,
    "text": "पेसे नाना जी के इस बजे से डोन आता है"
   },
   {
    "start": 1572.5,
    "end": 1574.5,
    "text": "इनके साथ मामाजी भी लगते है"
   },
   {
    "start": 1574.5,
    "end": 1576.5,
    "text": "इक अरक्ना जी चाथा जी है"
   },
   {
    "start": 1577.5,
    "end": 1579.5,
    "text": "अदेवा सी मित रही है"
   },
   {
    "start": 1579.5,
    "end": 1581.5,
    "text": "मैंपाल, ट्रीवर"
   },
   {
    "start": 1581.5,
    "end": 1583.5,
    "text": "इगाडी कडियो और आज हम"
   },
   {
    "start": 1583.5,
    "end": 1585.5,
    "text": "आज हम जे सपेषल देखने के लिए"
   },
   {
    "start": 1585.5,
    "end": 1588.5,
    "text": "तलो अपने ननी आल देख याते"
   },
   {
    "start": 1588.5,
    "end": 1590.5,
    "text": "और इनका ये गाम है"
   },
   {
    "start": 1590.5,
    "end": 1592.5,
    "text": "तो दिनेवाज सर"
   },
   {
    "start": 1592.5,
    "end": 1594.5,
    "text": "आरस्टार जसल्वर"
   },
   {
    "start": 1594.5,
    "end": 1596.5,
    "text": "चनल को देखते रही है"
   },
   {
    "start": 1596.5,
    "end": 1598.5,
    "text": "और इस से बोथ साथे"
   },
   {
    "start": 1598.5,
    "end": 1601.5,
    "text": "उसक्ती बिदियो में अर भी अपलोड करता रहुट रहूँट"
   },
   {
    "start": 1601.5,
    "end": 1603.5,
    "text": "जेसे साँँईषि जुड़े तुमे करता है रहेता।"
   },
   {
    "start": 1605.5,
    "end": 1607.5,
    "text": "तो मैं ने कि आर्पन मोला चनल आमवारा ये जो,"
   },
   {
    "start": 1607.5,
    "end": 1609.5,
    "text": "आरस्टार जसल्वर"
   },
   {
    "start": 1609.5,
    "end": 1611.5,
    "text": "विस पर सवी प्र कारके"
   },
   {
    "start": 1611.5,
    "end": 1613.5,
    "text": "औची तटा मजाए"
   },
   {
    "start": 1613.5,
    "end": 1616.8,
    "text": "याने सभी प्रकार के बीटियो आपको देकने चुनने को मिल जाएंगे"
   },
   {
    "start": 1616.8,
    "end": 1626.9,
    "text": "अगले मीटिये कि लिए प्रतिखषा किजी आप शिगरी में तुस्रा एक बीटियो पनाने जाराूं"
   },
   {
    "start": 1626.9,
    "end": 1632.7,
    "text": "तो कुमराम जी की फिता शिरी ते हमारे नाना जी"
   },
   {
    "start": 1636.1,
    "end": 1641.1,
    "text": "अप्को अपको आगले मीटियो बीटियो शाभाद"
   },
   {
    "start": 1641.1,
    "end": 1645.1,
    "text": "जैहींजे बार्द"
   },
   {
    "start": 1646.1,
    "end": 1653.4,
    "text": "जैहींजे बार्द जैऊशी दीराम"
   },
   {
    "start": 1653.4,
    "end": 1663.3,
    "text": "अवा शादी मणा अदी दिद मखान हो"
   },
   {
    "start": 1663.3,
    "end": 1667.1,
    "text": "यो ते मखाम हो बल ना"
   },
   {
    "start": 1667.1,
    "end": 1670.1,
    "text": "अगरु वाड पीटाड जे रा वा धाज"
   },
   {
    "start": 1670.1,
    "end": 1693.5,
    "text": "रांब रांब रांब"
   },
   {
    "start": 1693.5,
    "end": 1712.8,
    "text": "अच्या"
   },
   {
    "start": 1712.8,
    "end": 1716.8,
    "text": "बाहु चोटा माना रामजी"
   },
   {
    "start": 1716.8,
    "end": 1718.8,
    "text": "और बाशुब चोटाजका"
   },
   {
    "start": 1718.8,
    "end": 1720.8,
    "text": "इरा रामजी आरा पिताजी"
   },
   {
    "start": 1720.8,
    "end": 1721.8,
    "text": "अच्छ"
   },
   {
    "start": 1721.8,
    "end": 1722.8,
    "text": "ने साद्वा"
   },
   {
    "start": 1722.8,
    "end": 1723.8,
    "text": "ग्रस्ती और वारा गुरुजी"
   },
   {
    "start": 1723.8,
    "end": 1725.8,
    "text": "हावे भी कनेर शुहा"
   },
   {
    "start": 1725.8,
    "end": 1726.8,
    "text": "बे एक"
   },
   {
    "start": 1726.8,
    "end": 1728.8,
    "text": "शिद पूरूसा"
   },
   {
    "start": 1728.8,
    "end": 1731.8,
    "text": "तुबारी आप समादी बनुडी"
   },
   {
    "start": 1731.8,
    "end": 1733.8,
    "text": "यो बाव जी"
   },
   {
    "start": 1734.8,
    "end": 1735.8,
    "text": "जैवारू"
   },
   {
    "start": 1735.8,
    "end": 1739.5,
    "text": "जगे आजे की"
   },
   {
    "start": 1739.5,
    "end": 1741.5,
    "text": "कन दाई गाम होणी"
   },
   {
    "start": 1741.5,
    "end": 1743.5,
    "text": "आब या बी आप देख आगा लागे"
   },
   {
    "start": 1743.5,
    "end": 1802.7,
    "text": "गाम उटी आजी ते अव तुबना यो गो नहीं"
   },
   {
    "start": 1802.7,
    "end": 1804.7,
    "text": "अच्छ"
   },
   {
    "start": 1804.7,
    "end": 1806.7,
    "text": "आप गाडो एक श्टा"
   },
   {
    "start": 1806.7,
    "end": 1808.7,
    "text": "जद जद अद पोगडा बाटर नकिदा"
   },
   {
    "start": 1808.7,
    "end": 1811.7,
    "text": "येद बग भाली आ या भींद राली गा"
   },
   {
    "start": 1811.7,
    "end": 1815.4,
    "text": "बी दर लागे आप गाम करतिस्व"
   },
   {
    "start": 1815.4,
    "end": 1816.4,
    "text": "अच्छ"
   },
   {
    "start": 1816.4,
    "end": 1817.4,
    "text": "रादा सब कन"
   },
   {
    "start": 1817.4,
    "end": 1825.2,
    "text": "आद बे भी रागा गाम आच्छारे"
   },
   {
    "start": 1825.2,
    "end": 1827.2,
    "text": "आग्या दिना बे भीविन्या जब्या तो तुद अब वोड"
   },
   {
    "start": 1827.2,
    "end": 1834.0,
    "text": "वोगे आप"
   },
   {
    "start": 1834.0,
    "end": 1836.0,
    "text": "आप लगड़ गना यो भी आप"
   },
   {
    "start": 1836.0,
    "end": 1841.5,
    "text": "बलाए अद देखा"
   },
   {
    "start": 1841.5,
    "end": 1843.5,
    "text": "तो लगडि चकी"
   },
   {
    "start": 1843.5,
    "end": 1845.5,
    "text": "बरॐती कहने लिए बात है"
   },
   {
    "start": 1845.5,
    "end": 1847.5,
    "text": "दाख्ट्रा आप दाख्ट्रा वाग"
   },
   {
    "start": 1847.5,
    "end": 1859.2,
    "text": "समजमें को नियो"
   },
   {
    "start": 1859.2,
    "end": 1872.1,
    "text": "अपकी अपकी द्दे देखियर कोई"
   },
   {
    "start": 1872.1,
    "end": 1874.1,
    "text": "भीराम पोन"
   },
   {
    "start": 1874.1,
    "end": 1876.1,
    "text": "तेर बन"
   },
   {
    "start": 1876.1,
    "end": 1882.4,
    "text": "बन बी"
   },
   {
    "start": 1891.4,
    "end": 1898.6,
    "text": "बाशम भी"
   },
   {
    "start": 1898.6,
    "end": 1903.0,
    "text": "तर बशाक बन बादन बन बी पागड़ा नंभा भी गडी बद़ी बद़ा यी"
   },
   {
    "start": 1903.0,
    "end": 1906.0,
    "text": "ईख चोर्फ वो पूशाके"
   },
   {
    "start": 1906.0,
    "end": 1908.0,
    "text": "निए दो दब पश्ला सालगो"
   },
   {
    "start": 1908.0,
    "end": 1913.0,
    "text": "बन बद़ कुदी बदा जे आपी"
   },
   {
    "start": 1913.0,
    "end": 1915.0,
    "text": "अप बदन बद़ा यी काईवे"
   },
   {
    "start": 1915.0,
    "end": 1920.0,
    "text": "उसे अंकारो उग़ाबजके रहें बे होऽ।"
   },
   {
    "start": 1920.0,
    "end": 1928.9,
    "text": "अन मन बताई कै अगे औत यार कै लाँ या लगा न छयों कि खुषी वूई कै"
   },
   {
    "start": 1928.9,
    "end": 1938.2,
    "text": "जे ना आजा बे बत हों बंद्राडी हो अत हैं"
   },
   {
    "start": 1938.2,
    "end": 1945.2,
    "text": "तर खेश बिदोड या विन खाजवल का नि"
   },
   {
    "start": 1945.2,
    "end": 1949.2,
    "text": "उगर नाई उबी नकना बिन्द्राली वोखुम परनेदो"
   },
   {
    "start": 1949.2,
    "end": 1955.5,
    "text": "बान लगर आगे रभान के यार उखर याद"
   },
   {
    "start": 1955.5,
    "end": 1962.5,
    "text": "शरकन लाइगी ने चेडे के खुई मात्मागी समादी बता वैर बताखे है"
   },
   {
    "start": 1962.5,
    "end": 1967.7,
    "text": "सोड़ां के रोटी उगरी उखर आई उदाब दे मार तो सोड़ो भी मार"
   },
   {
    "start": 1970.3,
    "end": 1976.5,
    "text": "बान के गर उगर उगर शाग गर हैं तो एक मात्माग"
   },
   {
    "start": 1976.5,
    "end": 1978.5,
    "text": "खिराम रहें शुखर गिरी नाम"
   },
   {
    "start": 1978.5,
    "end": 1982.5,
    "text": "बिन्दे फुट्षो की बान की बाद तो मात्मागी बताखे है"
   },
   {
    "start": 1982.5,
    "end": 1985.5,
    "text": "अच्छा पंकर वैयो उगर बताखे है"
   },
   {
    "start": 1985.5,
    "end": 1987.5,
    "text": "दागन बोल द्यों"
   },
   {
