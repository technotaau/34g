   "found_by_query": "\u0916\u093f\u0902\u092f\u093e\u0923\u093e \u092e\u0939\u093e\u091c\u0928 \u092b\u093e\u092f\u0930\u093f\u0902\u0917 \u0930\u0947\u0902\u091c \u0935\u093f\u0938\u094d\u0925\u093e\u092a\u093f\u0924",
   "summary": "\u092f\u0939 \u092a\u0924\u094d\u0930\u093f\u0915\u093e \u0938\u092e\u093e\u091a\u093e\u0930 \u092e\u0939\u093e\u091c\u0928 \u092b\u0940\u0932\u094d\u0921 \u092b\u093e\u092f\u0930\u093f\u0902\u0917 \u0930\u0947\u0902\u091c \u0915\u0947 \u0932\u093f\u090f 1984-85 \u092e\u0947\u0902 \u0935\u093f\u0938\u094d\u0925\u093e\u092a\u093f\u0924 34 \u0917\u093e\u0902\u0935\u094b\u0902 \u092a\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u0939\u0948\u0964 \u0907\u0938\u092e\u0947\u0902 \u092d\u094b\u091c\u0930\u093e\u0938\u0930, \u0915\u0941\u092e\u094d\u092d\u093e\u0923\u093e, \u092e\u094b\u0924\u0932\u093e\u0908, \u0916\u093e\u0928\u0940\u0938\u0930, \u0925\u094b\u0907\u092f\u093e\u0902, \u092e\u094d\u0928\u0947\u0930\u093e\u0902 \u0914\u0930 \u0921\u0942\u0921\u0930 \u0917\u093e\u0902\u0935\u094b\u0902 \u0915\u0947 \u0928\u093e\u092e \u0935 \u0935\u093f\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0928\u093f\u0935\u093e\u0938\u093f\u092f\u094b\u0902 (\u0930\u093e\u091c\u0942 \u0930\u093e\u092e \u0936\u0930\u094d\u092e\u093e, \u092c\u091c\u0930\u0902\u0917 \u0932\u093e\u0932 \u0932\u0916\u094b\u091f\u093f\u092f\u093e) \u0915\u0947 \u0905\u0928\u0941\u092d\u0935 \u0926\u0930\u094d\u091c \u0939\u0948\u0902, \u092a\u0930\u0902\u0924\u0941 \u0916\u093f\u0902\u092f\u093e\u0923\u093e \u0917\u093e\u0902\u0935 \u0915\u093e \u0928\u093e\u092e \u0907\u0938 \u0932\u0947\u0916 \u092e\u0947\u0902 \u0938\u0940\u0927\u0947 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",
