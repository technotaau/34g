   "summary": "\u092e\u0939\u093e\u091c\u0928 \u0917\u093e\u0902\u0935 (\u0932\u0942\u0923\u0915\u0930\u0923\u0938\u0930 \u0924\u0939\u0938\u0940\u0932, \u092c\u0940\u0915\u093e\u0928\u0947\u0930) \u0915\u0940 \u091c\u0928\u0917\u0923\u0928\u093e 2011 \u091c\u0928\u0938\u0902\u0916\u094d\u092f\u093e \u0932\u0917\u092d\u0917 7397 \u0926\u093f\u0916\u093e\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0916\u093f\u0902\u092f\u093e\u0923\u093e \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0909\u092a-\u0924\u0939\u0938\u0940\u0932 \u092e\u0941\u0916\u094d\u092f\u093e\u0932\u092f \u0939\u0948 \u092a\u0930\u0902\u0924\u0941 \u0916\u093f\u0902\u092f\u093e\u0923\u093e \u0917\u093e\u0902\u0935 \u0915\u093e \u0938\u0940\u0927\u093e \u0909\u0932\u094d\u0932\u0947\u0916 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",
